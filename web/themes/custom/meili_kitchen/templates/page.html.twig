{#
/**
 * @file
 * Page layout: brand bar, search hero, facets rail and results.
 */
#}
{% set on_search = is_front or ('/recipes' in path('<current>')) %}
<div class="kitchen">
  <div class="kitchen__progress" aria-hidden="true"></div>
  <header class="kitchen__bar">
    <a class="kitchen__brand" href="{{ path('<front>') }}" rel="home">
      <span class="kitchen__logo" aria-hidden="true">🍳</span> Meili Kitchen
    </a>
    <nav class="kitchen__nav" aria-label="{{ 'Site'|t }}">
      <a href="{{ path('<front>') }}">{{ 'Recipes'|t }}</a>
      {% if logged_in %}
        <a href="{{ path('entity.search_api_index.canonical', {'search_api_index': 'recipes'}) }}">{{ 'Search settings'|t }}</a>
        <a href="{{ path('user.logout') }}">{{ 'Log out'|t }}</a>
      {% else %}
        <a href="{{ path('user.login') }}">{{ 'Log in'|t }}</a>
      {% endif %}
    </nav>
  </header>

  {% if page.hero %}
    <section class="kitchen__hero{{ on_search ? '' : ' kitchen__hero--compact' }}">
      {% if on_search %}
        <p class="kitchen__eyebrow">{{ 'Drupal 11 · Search API · Meilisearch'|t }}</p>
        <h1 class="kitchen__title">{{ 'What are we cooking?'|t }}</h1>
      {% endif %}
      {{ page.hero }}
    </section>
  {% endif %}

  <div class="kitchen__body{{ page.sidebar ? ' kitchen__body--with-rail' }}">
    {% if page.sidebar %}
      <aside class="kitchen__rail" data-kitchen-facets aria-label="{{ 'Filters'|t }}">
        {{ page.sidebar }}
      </aside>
    {% endif %}
    <main class="kitchen__main" data-kitchen-results>
      {{ page.content }}
    </main>
  </div>

  <footer class="kitchen__footer">
    <p>{% trans %}Every search goes through Views and Search API to <a href="https://www.meilisearch.com">Meilisearch</a>, with the <a href="https://www.drupal.org/project/meilisearch">drupal/meilisearch</a> backend. Recipes written for this demo.{% endtrans %}</p>
  </footer>
</div>
