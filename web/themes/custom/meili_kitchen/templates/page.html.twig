{#
/**
 * @file
 * Page layout: brand bar, search hero, facets rail and results.
 */
#}
<div class="kitchen">
  <header class="kitchen__bar">
    <a class="kitchen__brand" href="{{ path('<front>') }}" rel="home">
      <span class="kitchen__logo" aria-hidden="true">🍳</span> Meili Kitchen
    </a>
    <nav class="kitchen__nav" aria-label="{{ 'Site'|t }}">
      <a href="{{ path('<front>') }}">{{ 'Recipes'|t }}</a>
      {% if logged_in %}
        <a href="{{ path('search_api.overview') }}">{{ 'Search settings'|t }}</a>
      {% else %}
        <a href="{{ path('user.login') }}">{{ 'Log in'|t }}</a>
      {% endif %}
    </nav>
  </header>

  {% if page.hero %}
    {% set on_search = is_front or ('/recipes' in path('<current>')) %}
    <section class="kitchen__hero{{ on_search ? '' : ' kitchen__hero--compact' }}">
      {{ page.hero }}
      {% set typo = path('view.recipes.page_1', {}, {'query': {'search': 'chiken'}}) %}
      {% set phrase = path('view.recipes.page_1', {}, {'query': {'search': '"coconut milk"'}}) %}
      {% set exclude = path('view.recipes.page_1', {}, {'query': {'search': 'curry -chicken'}}) %}
      <p class="kitchen__hint">
        {% trans %}Misspell it (<a href="{{ typo }}">chiken</a>), look for a phrase (<a href="{{ phrase }}">"coconut milk"</a>) or leave something out (<a href="{{ exclude }}">curry -chicken</a>).{% endtrans %}
      </p>
    </section>
  {% endif %}

  <div class="kitchen__body{{ page.sidebar ? ' kitchen__body--with-rail' }}">
    {% if page.sidebar %}
      <aside class="kitchen__rail" data-kitchen-facets aria-label="{{ 'Filters'|t }}">
        {{ page.sidebar }}
      </aside>
    {% endif %}
    <main class="kitchen__main" data-kitchen-results>
      {{ page.content }}
    </main>
  </div>

  <footer class="kitchen__footer">
    {% trans %}Search runs on <a href="https://www.meilisearch.com">Meilisearch</a> through the <a href="https://www.drupal.org/project/meilisearch">drupal/meilisearch</a> Search API backend. Recipes written for this demo.{% endtrans %}
  </footer>
</div>
