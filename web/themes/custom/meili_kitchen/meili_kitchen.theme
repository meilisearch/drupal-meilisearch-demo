<?php

/**
 * @file
 * Theme functions of Meili Kitchen.
 */

declare(strict_types=1);

use Drupal\Component\Utility\Html;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Render\Markup;
use Drupal\Core\Site\Settings;

/**
 * Implements hook_preprocess_HOOK() for page.
 */
function meili_kitchen_preprocess_page(array &$variables): void {
  // A deployed demo has no login form (see the demo module).
  $variables['login_form'] = (bool) Settings::get('meilisearch_demo_login_form', FALSE);
}

/**
 * Implements hook_preprocess_HOOK() for views_view_fields.
 */
function meili_kitchen_preprocess_views_view_fields(array &$variables): void {
  if ($variables['view']->id() !== 'recipes') {
    return;
  }
  $plain = static fn(string $id): string => isset($variables['fields'][$id])
    ? trim(Html::decodeEntities(strip_tags((string) $variables['fields'][$id]->content)))
    : '';
  $variables['card'] = [
    'emoji' => $plain('emoji'),
    'cuisine' => $plain('cuisine'),
    'meals' => array_filter(array_map('trim', explode(',', $plain('meal_type')))),
    'diets' => array_filter(array_map('trim', explode(',', $plain('diet')))),
    'minutes' => (int) $plain('total_time'),
    'rating' => $plain('rating'),
    'title' => $plain('title'),
    'url' => NULL,
    'excerpt' => NULL,
    'ingredients' => NULL,
  ];

  $item = $variables['row']->_item ?? NULL;
  if (!$item) {
    return;
  }
  $entity = $item->getOriginalObject()?->getValue();
  if ($entity instanceof EntityInterface) {
    $variables['card']['url'] = $entity->toUrl()->toString();
  }
  // Highlights from the "Meilisearch highlighting" processor: escaped values
  // with <strong> around the matches. The title and the description get
  // their own. When only ingredients matched, a line names them, so the card
  // shows why it matched. Meilisearch adds "…" only where it cropped.
  $highlighted = $item->getExtraData('highlighted_fields', []);
  $words = meili_kitchen_query_words((string) ($variables['view']->getExposedInput()['search'] ?? ''));
  array_walk_recursive($highlighted, static function (&$value) use ($words): void {
    $value = meili_kitchen_whole_words((string) $value, $words);
  });
  if (!empty($highlighted['title'][0])) {
    $variables['card']['title'] = Markup::create($highlighted['title'][0]);
  }
  if (!empty($highlighted['body'][0])) {
    $variables['card']['excerpt'] = Markup::create(trim($highlighted['body'][0]));
  }
  elseif (!empty($highlighted['ingredients'])) {
    $variables['card']['ingredients'] = Markup::create(implode(', ', array_map('trim', array_slice($highlighted['ingredients'], 0, 3))));
  }
}

/**
 * The words of a search, lowercased and without accents.
 */
function meili_kitchen_query_words(string $search): array {
  $plain = mb_strtolower(\Drupal::transliteration()->transliterate($search, 'en'));
  return preg_split('/[^\p{L}\p{N}]+/u', $plain, -1, PREG_SPLIT_NO_EMPTY);
}

/**
 * Highlights the whole word on typo matches.
 *
 * On a typo, Meilisearch highlights as many characters as the query word has:
 * "chiken" marks "Chicke" in "Chicken". A highlight that is not one of the
 * query words is such a match, and is extended to the end of the word. One
 * that is a query word is a prefix match ("tirami" in "Tiramisu") and stays.
 *
 * @param string $html
 *   An escaped value with <strong> around the matches.
 * @param string[] $words
 *   The query words, from meili_kitchen_query_words().
 */
function meili_kitchen_whole_words(string $html, array $words): string {
  return preg_replace_callback('#<strong>([^<]*)</strong>([\p{L}\p{N}]+)#u', static function (array $match) use ($words): string {
    $marked = meili_kitchen_query_words(Html::decodeEntities($match[1]));
    if (count($marked) === 1 && in_array($marked[0], $words, TRUE)) {
      return $match[0];
    }
    return '<strong>' . $match[1] . $match[2] . '</strong>';
  }, $html) ?? $html;
}

/**
 * Implements hook_preprocess_HOOK() for node.
 */
function meili_kitchen_preprocess_node(array &$variables): void {
  $node = $variables['node'];
  if ($node->bundle() !== 'recipe') {
    return;
  }
  $labels = static fn(string $field): array => array_map(
    static fn($item) => $item->entity?->label(),
    iterator_to_array($node->get($field)),
  );
  $variables['recipe'] = [
    'emoji' => $node->get('field_emoji')->value,
    'cuisine' => $labels('field_cuisine')[0] ?? '',
    'meals' => $labels('field_meal_type'),
    'diets' => $labels('field_diet'),
    'minutes' => (int) $node->get('field_total_time')->value,
    'rating' => $node->get('field_rating')->value,
    'description' => $node->get('body')->value,
    'ingredients' => array_column($node->get('field_ingredients')->getValue(), 'value'),
  ];
}
